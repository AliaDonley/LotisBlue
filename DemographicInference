#!/usr/bin/env python3
import argparse           ##command line arguments like ad1 and popnames
import sys                ##exit with error message
import numpy as np     ##numeric operations on array
import pandas as pd     ## read/write tab-delimited files

def parse_args():    ##what arguments accepted from each command line. 
    p = argparse.ArgumentParser(description="Compute allele frequencies from pool-seq depth files")
    p.add_argument("--ad1",      required=True)    ##add argument will corespond to one of the flags when I run script. Required=true: script will show an error if I miss providing info
    p.add_argument("--ad2",      required=True)
    p.add_argument("--snpinfo",  required=True)
    p.add_argument("--popnames", required=True)
    p.add_argument("--out",      required=True)
    return p.parse_args()

def load_popnames(path):            ## reads pop names with provided format. if has no number prefix (which i got rid of) ,it just takes whole line
    with open(path) as fh:
        names = [line.strip() for line in fh if line.strip()]
    return names

def main():
    args = parse_args()
    popnames = load_popnames(args.popnames)
    n_pops = len(popnames)
    print(f"  Populations ({n_pops}): {', '.join(popnames)}")

    print(f"  Loading SNP info from: {args.snpinfo}")
    snpinfo = pd.read_csv(args.snpinfo, sep="\t", header=None,
                          names=["chrom", "pos", "ref", "alt"])
    n_sites = len(snpinfo)
    print(f"  Sites in snpinfo: {n_sites:,}")

    print(f"  Loading ref depths from: {args.ad1}")
    ad1 = pd.read_csv(args.ad1, sep="\t", header=None)
    print(f"  Loading alt depths from: {args.ad2}")
    ad2 = pd.read_csv(args.ad2, sep="\t", header=None)

    if ad1.shape != ad2.shape:
        sys.exit(f"ERROR: ad1 shape {ad1.shape} != ad2 shape {ad2.shape}")
    n_rows, n_cols = ad1.shape
    if n_rows != n_sites:
        sys.exit(f"ERROR: depth files have {n_rows} rows but snpinfo has {n_sites} rows")
    if n_cols != n_pops:
        sys.exit(f"ERROR: depth files have {n_cols} columns but {n_pops} population names provided")
    print(f"  Dimensions OK: {n_sites:,} sites x {n_pops} populations")

    ref_counts = ad1.values.astype(float)
    alt_counts = ad2.values.astype(float)
    total      = ref_counts + alt_counts

    with np.errstate(invalid="ignore", divide="ignore"):
        af = np.where(total > 0, alt_counts / total, np.nan)

    print(f"  Sites with zero depth in at least one pop: {np.any(total == 0, axis=1).sum():,}")

    extra = {}      ## building the otput table (af). loops over each pop and pulls out entire column (:,i). Will have 4 columns per pop (ref count, alt count, total depth, and AF)
    for i, pop in enumerate(popnames):
        extra[f"ref_{pop}"]   = ref_counts[:, i].astype(int)
        extra[f"alt_{pop}"]   = alt_counts[:, i].astype(int)
        extra[f"depth_{pop}"] = total[:, i].astype(int)
        extra[f"af_{pop}"]    = np.round(af[:, i], 6)

    out = pd.concat([snpinfo, pd.DataFrame(extra)], axis=1)       ## concats and writes to output table
    out.to_csv(args.out, sep="\t", index=False)
    print(f"  Written: {args.out}  ({len(out):,} sites)")

    af_cols = [f"af_{p}" for p in popnames]
    mean_af = out[af_cols].mean()
    print("\n  Mean alt allele frequency per population:")
    for pop, val in zip(popnames, mean_af):
        print(f"    {pop:<15s}  {val:.4f}")

if __name__ == "__main__":
    main()

