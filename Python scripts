TO FIND THE CORRELATION
python3 - << 'EOF'
import pandas as pd
import numpy as np

df = pd.read_csv("allele_freqs_YG20_SHC11.txt", sep="\t")

af_yg  = df["af_Lyc-YG20"].values
af_shc = df["af_Lyc-SHC11"].values

# Remove sites where either is NaN
keep = np.isfinite(af_yg) & np.isfinite(af_shc)
af_yg  = af_yg[keep]
af_shc = af_shc[keep]

corr = np.corrcoef(af_yg, af_shc)[0, 1]
print(f"Sites used: {keep.sum():,}")
print(f"Pearson correlation: {corr:.4f}")
EOF


AND PLOT IT
python3 - << 'EOF'
import pandas as pd
import numpy as np
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt

df = pd.read_csv("allele_freqs_YG20_SHC11.txt", sep="\t")

af_yg  = df["af_Lyc-YG20"].values
af_shc = df["af_Lyc-SHC11"].values

keep = np.isfinite(af_yg) & np.isfinite(af_shc)
af_yg  = af_yg[keep]
af_shc = af_shc[keep]

corr = np.corrcoef(af_yg, af_shc)[0, 1]

fig, ax = plt.subplots(figsize=(7, 6))

# Hexbin plot — better than scatter for 400k points
hb = ax.hexbin(af_yg, af_shc, gridsize=80, cmap="viridis", mincnt=1, bins="log")
plt.colorbar(hb, ax=ax, label="log10(site count)")

ax.set_xlabel("Lyc-YG20 allele frequency", fontsize=12)
ax.set_ylabel("Lyc-SHC11 allele frequency", fontsize=12)
ax.set_title(f"Allele frequency correlation\nr = {corr:.4f}  |  n = {keep.sum():,} sites", fontsize=12)

# 1:1 line
ax.plot([0, 1], [0, 1], "r--", linewidth=1, label="1:1 line")
ax.legend()

plt.tight_layout()
plt.savefig("AF_correlation_YG20_SHC11.pdf", dpi=150, bbox_inches="tight")
print("Saved -> AF_correlation_YG20_SHC11.pdf")
EOF
